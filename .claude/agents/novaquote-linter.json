{
  "name": "novaquote-linter",
  "description": "Agent de linting et correction automatique pour le projet NovaQuote Trading",
  "version": "1.0.0",
  "category": "development",
  "tags": ["linting", "typescript", "python", "formatting", "code-quality"],
  "invocation": {
    "explicit": "Utilise novaquote-linter",
    "alias": ["linter", "novaquote-lint", "fix-code"],
    "via_agents_interface": true
  },
  "capabilities": [
    "Analyse TypeScript complète",
    "Linting Python avec flake8/black/isort",
    "Formatting automatique",
    "Correction d'erreurs",
    "Validation post-correction",
    "Reporting détaillé"
  ],
  "scripts_integration": {
    "primary": [
      "scripts/CLAUDE_AUTO_LINTER.py",
      "scripts/auto_bug_fixer_cli.py",
      "scripts/lint-format-py.py"
    ],
    "secondary": ["scripts/fix_emojis.py", "scripts/CLAUDE_CODE_SUBAGENT.py"]
  },
  "target_files": {
    "typescript": [
      "backend/**/*.ts",
      "frontend/**/*.ts",
      "src/core/**/*.ts",
      "src/metrics/**/*.ts",
      "src/security/**/*.ts",
      "src/validation/**/*.ts"
    ],
    "python": [
      "src/**/*.py",
      "src/agents/**/*.py",
      "src/algorithms/**/*.py",
      "src/models/**/*.py",
      "scripts/**/*.py"
    ]
  },
  "lint_commands": {
    "typescript": {
      "compile": "npx tsc --noEmit --strict",
      "lint": "npx eslint . --ext .ts,.tsx",
      "format": "npx prettier --check .",
      "format_fix": "npx prettier --write ."
    },
    "python": {
      "lint": "flake8 src/ --max-line-length=100",
      "format_check": "black --check src/",
      "format_fix": "black src/",
      "imports_check": "isort --check-only src/",
      "imports_fix": "isort src/",
      "type_check": "mypy src/ --ignore-missing-imports"
    }
  },
  "workflow": {
    "phases": [
      {
        "name": "initialisation",
        "description": "Création Todo List et analyse complète",
        "actions": ["scan_files", "create_todos", "analyze_codebase"]
      },
      {
        "name": "detection",
        "description": "Exécution des commandes de lint",
        "actions": ["run_tsc", "run_flake8", "check_formatting"]
      },
      {
        "name": "correction",
        "description": "Correction automatique via scripts",
        "actions": ["run_linter_scripts", "fix_errors", "apply_formatting"]
      },
      {
        "name": "validation",
        "description": "Validation post-correction",
        "actions": ["re_lint", "verify_fixes", "generate_report"]
      }
    ]
  },
  "todo_management": {
    "auto_generate": true,
    "detailed_tracking": true,
    "completion_criteria": "all_lint_commands_clean",
    "max_iterations": 3,
    "persistent_execution": true
  },
  "success_criteria": {
    "typescript_clean": "npx tsc --noEmit retourne 0",
    "python_clean": "flake8 src/ retourne 0",
    "formatting_clean": "black --check src/ ET prettier --check . retournent 0"
  },
  "integration": {
    "related_agents": [
      "novaquote-bug-fixer",
      "novaquote-code-reviewer",
      "novaquote-perf-optimizer"
    ],
    "escalation_rules": {
      "critical_errors": "novaquote-bug-fixer",
      "quality_issues": "novaquote-code-reviewer",
      "performance_issues": "novaquote-perf-optimizer"
    }
  },
  "parameters": {
    "optional": [
      {
        "name": "--target",
        "description": "Cible spécifique (typescript/python/folder)",
        "values": ["typescript", "python", "src/agents/", "backend/"]
      },
      {
        "name": "--fix-only",
        "description": "Skip analysis, apply fixes only",
        "type": "boolean"
      },
      {
        "name": "--max-iterations",
        "description": "Nombre maximum de cycles de correction",
        "type": "number",
        "default": 3
      }
    ]
  }
}
