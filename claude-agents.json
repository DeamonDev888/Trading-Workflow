{
  "swarm_metadata": {
    "name": "NOVAQUOTE Trading Agents",
    "version": "1.0",
    "description": "Agents de trading NOVAQUOTE avec Claude Code sub-agents - 4 experts spécialisés",
    "author": "Deamon Dev",
    "created": "2025-11-09",
    "tags": ["trading", "crypto", "finance", "algorithmic-trading"],
    "contact": "dev@novaquote.ai"
  },

  "orchestration": {
    "mode": "delegation",
    "max_concurrent": 4,
    "load_balancing": "round_robin",
    "health_check_interval": 30,
    "auto_scaling": {
      "enabled": false,
      "min_agents": 1,
      "max_agents": 4
    },
    "priority_queue": {
      "critical": ["claude-risk-advisor"],
      "high": ["claude-strategy-advisor"],
      "medium": ["claude-funding-advisor", "claude-sentiment-analyzer"]
    }
  },

  "agents": [
    {
      "id": "claude-strategy-advisor",
      "name": "Strategy Advisor",
      "enabled": true,
      "priority": "high",
      "config": ".claude/agents/claude-strategy-advisor.json",
      "description": "Analyse les signaux de trading et recommande des stratégies",
      "dependencies": ["claude-sentiment-analyzer"],
      "max_instances": 2,
      "auto_restart": true
    },
    {
      "id": "claude-risk-advisor",
      "name": "Risk Advisor",
      "enabled": true,
      "priority": "critical",
      "config": ".claude/agents/claude-risk-advisor.json",
      "description": "Gestion des risques et position sizing",
      "dependencies": ["claude-strategy-advisor"],
      "max_instances": 1,
      "auto_restart": true
    },
    {
      "id": "claude-funding-advisor",
      "name": "Funding Advisor",
      "enabled": true,
      "priority": "medium",
      "config": ".claude/agents/claude-funding-advisor.json",
      "description": "Arbitrage et optimisation des taux de funding",
      "dependencies": ["claude-strategy-advisor"],
      "max_instances": 1,
      "auto_restart": true
    },
    {
      "id": "claude-sentiment-analyzer",
      "name": "Sentiment Analyzer",
      "enabled": true,
      "priority": "medium",
      "config": ".claude/agents/claude-sentiment-analyzer.json",
      "description": "Analyse du sentiment du marché et social",
      "dependencies": [],
      "max_instances": 1,
      "auto_restart": true
    }
  ],

  "workflows": {
    "complete_trading_analysis": {
      "description": "Analyse complète de trading avec tous les agents",
      "estimated_time": "3-5 minutes",
      "sequence": [
        "claude-sentiment-analyzer",
        "claude-strategy-advisor",
        "claude-risk-advisor",
        "claude-funding-advisor"
      ],
      "parallel_groups": [
        ["claude-sentiment-analyzer"],
        ["claude-strategy-advisor"],
        ["claude-risk-advisor", "claude-funding-advisor"]
      ]
    },
    "quick_decision": {
      "description": "Décision rapide (stratégie + risque uniquement)",
      "estimated_time": "1-2 minutes",
      "sequence": [
        "claude-sentiment-analyzer",
        "claude-strategy-advisor",
        "claude-risk-advisor"
      ],
      "parallel_groups": [
        ["claude-sentiment-analyzer"],
        ["claude-strategy-advisor"],
        ["claude-risk-advisor"]
      ]
    }
  },

  "monitoring": {
    "metrics": {
      "enabled": true,
      "interval": 15,
      "retention": "7d",
      "export_format": ["json"]
    },
    "alerts": {
      "enabled": true,
      "channels": ["console", "file"],
      "thresholds": {
        "confidence_threshold": 0.8,
        "timeout_threshold": 120
      }
    }
  },

  "cli": {
    "usage": {
      "basic": "claude --agents @claude-agents.json",
      "delegation": "claude --agents @claude-agents.json --print --dangerously-skip-permissions \"Analyze trading opportunity\"",
      "single_agent": "claude --agents .claude/agents/claude-strategy-advisor.json --print --dangerously-skip-permissions \"task\"",
      "complete": "claude --agents @claude-agents.json --workflow complete_trading_analysis"
    },
    "examples": [
      "claude --agents @claude-agents.json --print --dangerously-skip-permissions \"Should I buy BTC at $50,000?\"",
      "claude --agents .claude/agents/claude-risk-advisor.json --print --dangerously-skip-permissions \"Assess portfolio risk\"",
      "claude --agents @claude-agents.json --workflow quick_decision"
    ]
  }
}
