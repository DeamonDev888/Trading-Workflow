# =============================================================================
# 🚀 NOVAQUOTE MAINNET CONFIGURATION - OPTIMISÉE POUR GAINS MAXIMAUX
# =============================================================================
# ⚠️  ATTENTION: Configuration pour TRADING RÉEL avec argent VRAI !
# Utilisez cette configuration uniquement lorsque vous êtes prêt pour le mainnet.

# 🔑 HYPERLIQUID MAINNET API
HYPER_LIQUID_KEY=votre_eth_private_key_ici_64_caracteres_hex
HYPERLIQUID_TESTNET=false

# 🎯 CONFIGURATION TRADING OPTIMISÉE
TRADING_MODE=mainnet
DEFAULT_LEVERAGE=5x
MAX_POSITION_SIZE=5000
MIN_SIGNAL_FORCE=0.65
AGGRESSIVE_MODE=true

# ⚡ CONFIGURATION AUTO-TRADING HAUTE FRÉQUENCE
AUTO_TRADING_ENABLED=true
AUTO_TRADING_INTERVAL=30
SAFETY_MODE=true
MAX_DAILY_TRADES=50
STOP_LOSS_PERCENTAGE=2.0
TAKE_PROFIT_PERCENTAGE=4.0

# 💰 RISK MANAGEMENT AVANCÉ
MAX_RISK_PER_TRADE=2.0
MAX_TOTAL_EXPOSURE=20.0
MIN_WIN_RATE=0.65
MAX_DRAWDOWN=10.0

# 🎪 MODE UNIDIRECTIONNEL (DÉSACTIVÉ POUR MAXIMUM DE FLEXIBILITÉ)
UNIDIRECTIONAL_MODE=false
ALLOWED_SIDE=both

# 🤖 AGENTS IA CONFIGURATION
AGENT_CONFIDENCE_THRESHOLD=0.70
AGENT_UPDATE_INTERVAL=15000
MAX_LLM_CALLS_PER_MINUTE=10

# 📊 SYMBOLS PRIORITAIRES (HIGH VOLUME)
PRIORITY_SYMBOLS=BTC,ETH,SOL
VOLATILE_SYMBOLS=ARB,APT,ADA,AVAX,BNB

# 🔄 WebSocket Configuration
WS_RECONNECT_ATTEMPTS=100
WS_HEARTBEAT_INTERVAL=10000
WS_CONNECTION_TIMEOUT=5000

# 📈 PERFORMANCE MONITORING
ENABLE_METRICS=true
LOG_LEVEL=info
SAVE_TRADES=true
PERFORMANCE_TRACKING=true

# 🛡️ SÉCURITÉ ET VALIDATION
ENABLE_POSITION_VALIDATION=true
ENABLE_RISK_CHECKS=true
MAX_SLIPPAGE=0.5
MIN_LIQUIDITY=10000

# 💾 DATABASE CONFIGURATION
DB_PATH=src/market_database/market_data_mainnet.db
WALLET_DB_PATH=src/market_database/wallet_mainnet.db
BACKUP_ENABLED=true
BACKUP_INTERVAL=300000

# 🔔 NOTIFICATIONS
DISCORD_WEBHOOK_URL=votre_webhook_discord_ici
TELEGRAM_BOT_TOKEN=votre_token_telegram_ici
ALERTS_ENABLED=true

# 🌍 RÉSEAU
NODE_ENV=production
API_RATE_LIMIT=100
TIMEOUT=30000

# =============================================================================
# 📋 INSTRUCTIONS DÉPLOYEMENT MAINNET:
# =============================================================================
# 1. Copiez ce fichier vers .env
# 2. Remplacez 'votre_eth_private_key_ici_64_caracteres_hex' par votre VRAIE clé privée Ethereum
# 3. Configurez vos webhooks Discord/Telegram pour les alertes
# 4. Vérifiez que votre portefeuille HyperLiquid a des fonds suffisants
# 5. Lancez: npm run dev
# 6. Surveillez attentivement les premiers trades
# 7. Ajustez les paramètres de risque selon vos préférences

# ⚠️ RISQUES IMPORTANTS:
# - Trading avec argent réel
# - Pertes possibles jusqu'à 100% du capital
# - Volatilité extrême du marché crypto
# - Testez d'abord en paper trading pendant au moins 1 semaine

# 📞 SUPPORT:
# En cas de problème urgent: arrêtez immédiatement avec Ctrl+C
# Contactez le support si vous détectez des comportements anormaux
# =============================================================================